{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hermes Gateway verifier receipt evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "proofSource", "supportEligible", "runId", "recordedAt", "deploymentCondition", "trustClass", "muxyVersion", "hermesVersion", "hermesRevisionOrDigest", "requiredStages", "sseFrames", "verdict", "reasonCode"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "proofSource": { "enum": ["verifier_receipt_bundle", "unverified_failure_adapter"] },
    "supportEligible": { "type": "boolean" },
    "runId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{7,159}$" },
    "recordedAt": { "type": "string", "format": "date-time" },
    "deploymentCondition": { "enum": ["host_native_loopback", "docker_published_loopback", "ssh_local_forward", "direct_remote_https", "remote_muxy_workspace"] },
    "trustClass": { "enum": ["loopback_http", "trusted_https", "simulated"] },
    "muxyVersion": { "$ref": "#/$defs/token" },
    "hermesVersion": { "$ref": "#/$defs/token" },
    "hermesRevisionOrDigest": { "$ref": "#/$defs/token" },
    "qualificationId": { "$ref": "#/$defs/token" },
    "sessionOrdinal": { "enum": [1, 2] },
    "panelDigest": { "$ref": "#/$defs/digest" },
    "relayDigest": { "$ref": "#/$defs/digest" },
    "fixtureDigest": { "$ref": "#/$defs/digest" },
    "challengeDigest": { "$ref": "#/$defs/digest" },
    "cleanupDigest": { "$ref": "#/$defs/digest" },
    "attemptCategory": { "enum": ["simulation", "real_attempt", "incomplete", "failure"] },
    "requiredStages": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "relay", "authentication", "capabilities", "stream", "cleanup"],
      "properties": {
        "url": { "$ref": "#/$defs/stage" }, "relay": { "$ref": "#/$defs/stage" }, "authentication": { "$ref": "#/$defs/stage" }, "capabilities": { "$ref": "#/$defs/stage" }, "stream": { "$ref": "#/$defs/stage" }, "cleanup": { "$ref": "#/$defs/stage" }
      }
    },
    "capabilityShapeHash": { "$ref": "#/$defs/digest" },
    "sseFrames": { "type": "array", "items": { "$ref": "#/$defs/frame" } },
    "verdict": { "const": "Unverified" },
    "reasonCode": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,79}$" }
  },
  "allOf": [
    {
      "if": { "properties": { "proofSource": { "const": "verifier_receipt_bundle" } } },
      "then": { "properties": { "supportEligible": { "const": true } }, "required": ["qualificationId", "sessionOrdinal", "panelDigest", "relayDigest", "fixtureDigest", "challengeDigest", "cleanupDigest", "capabilityShapeHash"] }
    },
    {
      "if": { "properties": { "proofSource": { "const": "unverified_failure_adapter" } } },
      "then": { "properties": { "supportEligible": { "const": false } }, "required": ["attemptCategory"] }
    }
  ],
  "$defs": {
    "token": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,159}$" },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "stage": { "enum": ["passed", "failed", "not_verified"] },
    "frame": {
      "type": "object", "additionalProperties": false,
      "required": ["event", "idBehavior", "order", "elapsedMs", "dataBytes", "shapeHash"],
      "properties": {
        "event": { "$ref": "#/$defs/token" }, "idBehavior": { "enum": ["absent", "present", "changed"] }, "order": { "type": "integer", "minimum": 0 }, "elapsedMs": { "type": "integer", "minimum": 0 }, "dataBytes": { "type": "integer", "minimum": 0 }, "shapeHash": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
