{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hermes Gateway validation evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "recordedAt", "deploymentCondition", "trustClass", "realPath", "simulation", "muxyVersion", "hermesVersion", "hermesRevisionOrDigest", "requiredStages", "freshPanelSession", "sessionOrdinal", "originVerdict", "capabilityShapeHash", "sseFrames", "verdict", "reasonCode"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "runId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{7,159}$" },
    "recordedAt": { "type": "string", "format": "date-time" },
    "deploymentCondition": { "enum": ["host_native_loopback", "docker_published_loopback", "ssh_local_forward", "direct_remote_https", "remote_muxy_workspace"] },
    "trustClass": { "enum": ["loopback_http", "trusted_https", "simulated"] },
    "realPath": { "type": "boolean" },
    "simulation": { "type": "boolean" },
    "muxyVersion": { "type": "string" },
    "hermesVersion": { "type": "string" },
    "hermesRevisionOrDigest": { "type": "string" },
    "requiredStages": { "type": "object", "additionalProperties": false, "required": ["url", "request", "authentication", "origin", "capabilities", "stream"], "properties": { "url": { "$ref": "#/$defs/stage" }, "request": { "$ref": "#/$defs/stage" }, "authentication": { "$ref": "#/$defs/stage" }, "origin": { "$ref": "#/$defs/stage" }, "capabilities": { "$ref": "#/$defs/stage" }, "stream": { "$ref": "#/$defs/stage" } } },
    "freshPanelSession": { "type": "boolean" },
    "sessionOrdinal": { "enum": [1, 2] },
    "originVerdict": { "enum": ["exact_origin_passed", "origin_rejected", "not_verified"] },
    "capabilityShapeHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sseFrames": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["event", "idBehavior", "order", "elapsedMs", "dataBytes", "shapeHash"], "properties": { "event": { "type": "string" }, "idBehavior": { "enum": ["absent", "present", "changed"] }, "order": { "type": "integer", "minimum": 0 }, "elapsedMs": { "type": "integer", "minimum": 0 }, "dataBytes": { "type": "integer", "minimum": 0 }, "shapeHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } } },
    "verdict": { "enum": ["Supported", "Unsupported", "Unverified"] },
    "reasonCode": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,79}$" }
  },
  "$defs": { "stage": { "enum": ["passed", "failed", "not_verified"] } }
}
